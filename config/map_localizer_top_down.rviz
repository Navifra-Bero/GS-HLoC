Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map Cloud1
        - /Top Down Cloud1
        - /Visited Region1
        - /Visible Region1
        - /Visible BBox1
        - /Camera Image1
        - /Camera Frustum1
        - /Camera Pose1
        - /Trajectory1
        - /Matching Points1
        - /Matching Lines1
      Splitter Ratio: 0.5
    Tree Height: 850
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: false
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true

    # ── top-down 오버뷰 맵 (/top_down_cloud, latching) ───────────
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color: 160; 160; 160
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Top Down Cloud
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.2
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /top_down_cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

    # ── 전체 맵 (중간 밝기, latching) ────────────────────────────
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color: 130; 130; 130
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Map Cloud
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 4
      Size (m): 0.2
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

    # ── 누적 방문 영역 (지나온 전체 경로, latching) ───────────────
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 220; 50
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Visited Region
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 4
      Size (m): 0.2
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visited_region
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    # ── 현재 가시 영역 (원본 색 100%) ────────────────────────────
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 220; 50
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Visible Region
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.2
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /visible_region
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    # ── 가시 영역 경계박스 ────────────────────────────────────────
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Visible BBox
      Namespaces:
        visible_bbox: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /visible_bbox
      Value: true

    # ── 현재 프레임 이미지 (2D 패널) ────────────────────────────────
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Camera Image
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cam/image
      Value: true

    # ── 카메라 절두체 + frustum 이미지 (wireframe + image 동시 발행) ──
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Camera Frustum
      Namespaces:
        frustum: true
        frustum_image: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera_frustum
      Value: true

    # ── 카메라 포즈 (빨간 화살표) ────────────────────────────────
    - Alpha: 1
      Axes Length: 0.5
      Axes Radius: 0.05
      Class: rviz_default_plugins/Pose
      Color: 255; 25; 0
      Enabled: false
      Head Length: 0.2
      Head Radius: 0.1
      Name: Camera Pose
      Shaft Length: 0.5
      Shaft Radius: 0.05
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera_pose
      Value: true

    # ── 누적 경로 (파란색 스플라인 곡선) ─────────────────────────
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Trajectory
      Namespaces:
        trajectory: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /trajectory_line
      Value: true

    # ── step6 매칭 3D 포인트 (빨간색) ───────────────────────────────

    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 0; 0
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Matching Points
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.2
      Style: Spheres
      Topic:
        Depth: 10
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /matching_points
      Use Fixed Frame: true
      Use rainbow: false
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Matching Lines
      Namespaces:
        matching_lines: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /matching_lines
      Value: true

  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Icons: false
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    # cam_fp: 카메라에서 frust_d(2m) 전방에 위치
    # ThirdPersonFollower(distance=2m)로 cam_fp를 추적하면
    # RViz 카메라가 실제 카메라 위치에서 정면을 바라보는 1인칭 시점이 

    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 50.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: TopDown Fixed
      Near Clip Distance: 0.01
      Pitch: 1.5707
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0
    Saved:
      - Class: rviz_default_plugins/ThirdPersonFollower
        Distance: 8.0
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Name: Overview
        Near Clip Distance: 0.01
        Pitch: 0.4
        Target Frame: cam_view
        Value: ThirdPersonFollower (rviz)
        Yaw: 0
Window Geometry:
  Displays:
    collapsed: false
  Height: 1080
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1920
  X: 0
  Y: 0
