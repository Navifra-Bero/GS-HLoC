<?xml version="1.0"?>
<package format="3">
  <name>render_loc</name>
  <version>0.1.0</version>
  <description>
    RenderLoc: Single-image 6DoF visual localization in LiDAR point cloud maps.
    Renders synthetic images from PLY map, builds feature database offline,
    then localizes query images via retrieval + matching + PnP.
  </description>
  <maintainer email="user@todo.com">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Python 실시간 노드 런타임 의존성 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
</package>
